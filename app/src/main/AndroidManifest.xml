<?xml version="1.0" encoding="utf-8"?>
<!-- FILE: app/src/main/AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Weather forecast (Phase 4) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Reminder notifications (Android 13+ asks at runtime) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Leaf Disease Detection camera (asked at runtime) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="KisanBandhu"
        android:theme="@style/Theme.KisanBandhu"
        android:usesCleartextTraffic="true">

        <!-- Splash screen - app entry point -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 1 -->
        <activity android:name=".activities.HomeActivity" android:exported="false" />

        <!-- Phase 2 -->
        <activity android:name=".activities.SoilInputActivity" android:exported="false" />
        <activity android:name=".activities.SoilAnalysisActivity" android:exported="false" />

        <!-- Phase 3 -->
        <activity android:name=".activities.CropRecommendationActivity" android:exported="false" />

        <!-- Phase 4 -->
        <activity android:name=".activities.CropSelectionActivity" android:exported="false" />
        <activity android:name=".activities.CropDashboardActivity" android:exported="false" />
        <activity android:name=".activities.CropCalendarActivity" android:exported="false" />
        <activity android:name=".activities.FertilizerActivity" android:exported="false" />
        <activity android:name=".activities.PesticideActivity" android:exported="false" />
        <activity android:name=".activities.WeatherActivity" android:exported="false" />
        <activity android:name=".activities.WeatherAlertsActivity" android:exported="false" />
        <activity android:name=".activities.RemindersActivity" android:exported="false" />
        <activity android:name=".activities.LeafDiseaseActivity" android:exported="false" />

        <receiver android:name=".utils.ReminderReceiver" android:exported="false" />

    </application>

</manifest>
