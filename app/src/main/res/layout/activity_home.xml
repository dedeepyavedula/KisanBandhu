<?xml version="1.0" encoding="utf-8"?>
<!-- FILE: app/src/main/res/layout/activity_home.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: greeting + currently selected crop -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome, Farmer 👋"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark" />

        <TextView
            android:id="@+id/tvSelectedCrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No crop selected yet"
            android:textSize="15sp"
            android:textColor="@color/brown_soil"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- ===== Feature card: Crop Recommendations ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCropRecommend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:textSize="17sp"
                android:textColor="@color/text_dark"
                android:text="🌱  @string/card_crop_recommend" />
        </androidx.cardview.widget.CardView>

        <!-- ===== Feature card: Weather ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardWeather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:textSize="17sp"
                android:textColor="@color/text_dark"
                android:text="🌦  @string/card_weather" />
        </androidx.cardview.widget.CardView>

        <!-- ===== Feature card: Crop Calendar ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:textSize="17sp"
                android:textColor="@color/text_dark"
                android:text="📅  @string/card_calendar" />
        </androidx.cardview.widget.CardView>

        <!-- ===== Feature card: Fertilizer ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFertilizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:textSize="17sp"
                android:textColor="@color/text_dark"
                android:text="🧪  @string/card_fertilizer" />
        </androidx.cardview.widget.CardView>

        <!-- ===== Feature card: Pest / Disease Guidance ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPesticide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:textSize="17sp"
                android:textColor="@color/text_dark"
                android:text="🐛  @string/card_pesticide" />
        </androidx.cardview.widget.CardView>

        <!-- ===== Feature card: Reminders ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardReminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:textSize="17sp"
                android:textColor="@color/text_dark"
                android:text="🔔  @string/card_reminders" />
        </androidx.cardview.widget.CardView>

        <!-- ===== Feature card: Leaf Disease Detection ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLeafDisease"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:textSize="17sp"
                android:textColor="@color/text_dark"
                android:text="🍃  @string/card_leaf_disease" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
